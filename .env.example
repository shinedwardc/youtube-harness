# Copy this file to .env and fill in at least GEMINI_API_KEY.

# --- Keys ---
# Get one at https://aistudio.google.com/apikey (free tier, no card)
GEMINI_API_KEY=
# Optional fallback. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# --- Providers (all optional; env vars beat the presets in harness/core/llm.py) ---
# HARNESS_PROVIDER=gemini              # gemini | groq | ollama
# HARNESS_MODEL=                       # override the provider's default model
# HARNESS_BASE_URL=                    # override the provider's default endpoint
# HARNESS_MAX_INPUT_TOKENS=            # transcripts above this are map-reduced
# HARNESS_FALLBACK_PROVIDER=groq       # empty disables the fallback
# HARNESS_FALLBACK_MODEL=
# HARNESS_FALLBACK_BASE_URL=
# HARNESS_FALLBACK_MAX_INPUT_TOKENS=

# --- Harness ---
# HARNESS_VAULT_DIR=./vault            # notes go to <vault>/youtube/
# HARNESS_VAULT_NAME=                  # Obsidian's name for the vault; defaults to the folder's name
# HARNESS_DB_PATH=./data/harness.db
# HARNESS_SUMMARY_LANGUAGE=auto        # auto matches the captions; or en, ko, ...
# HARNESS_POLL_INTERVAL=1.0            # seconds between worker checks for new jobs

# --- Docker ---
# Compose mounts HARNESS_VAULT_DIR as /vault, so the folder's name is lost inside the container.
# If your vault isn't called "vault", set HARNESS_VAULT_NAME above or "open in Obsidian" links break.
# TZ=Asia/Seoul                        # the container defaults to UTC, which can misdate notes
